# Client (Vercel) — set in Vercel Project → Settings → Environment Variables
# VITE_UFC_API=https://your-ufc-api.up.railway.app

# Server (Railway) — set in Railway Variables tab
DATABASE_URL=postgresql://user:password@host:5432/dbname
NODE_ENV=production

# Optional — extra allowed CORS origin if frontend is hosted elsewhere
# FRONTEND_URL=https://kylesuda.com

# Optional user API — disabled by default in production.
# If enabled, use a long random secret and send it in the X-API-Key header.
ENABLE_USER_API=false
# USER_API_KEY=replace-with-a-long-random-secret
